# Copy this file to .env and fill in real values. Never commit .env.

# Long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Database connection. Local development uses a SQLite file.
DATABASE_URI=file:./zirka.db

# Public address of the site, used in the sitemap and share previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
